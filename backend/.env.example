# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

PUERTO=3000

# La API del negocio se conecta como mc_app (sujeto a RLS).
DATABASE_URL=postgres://mc_app:cambiar-app@localhost:5432/micentralmx
# Panel de plataforma (superadministrador): mc_plataforma, pool separado.
DATABASE_PLATAFORMA_URL=postgres://mc_plataforma:cambiar-plataforma@localhost:5432/micentralmx
# Migraciones y semilla: mc_owner (dueño de las tablas).
DATABASE_OWNER_URL=postgres://mc_owner:cambiar-owner@localhost:5432/micentralmx

# Firma de los access tokens (mínimo 32 caracteres aleatorios).
JWT_SECRETO=cambiar-por-un-secreto-largo-y-aleatorio-de-32+
# Token para crear negocios desde /api/plataforma (superadministrador).
PLATAFORMA_TOKEN=cambiar-token-de-plataforma

# true detrás de HTTPS (Caddy): la cookie de refresh solo viaja cifrada.
COOKIE_SEGURA=false
