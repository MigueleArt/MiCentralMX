# Variables de docker-compose.yml. Copia a .env y reemplaza TODOS los valores.
POSTGRES_PASSWORD=cambiar-superusuario
MC_OWNER_PASSWORD=cambiar-owner
MC_APP_PASSWORD=cambiar-app
MC_PLATAFORMA_PASSWORD=cambiar-plataforma
JWT_SECRETO=cambiar-por-un-secreto-largo-y-aleatorio-de-32+
PLATAFORMA_TOKEN=cambiar-token-de-plataforma
# Dominio público; con "localhost" Caddy usa un certificado local.
DOMINIO=localhost
# Puertos publicados por Caddy (cámbialos si el equipo ya usa 80/443, p. ej. Laragon).
PUERTO_HTTP=80
PUERTO_HTTPS=443
